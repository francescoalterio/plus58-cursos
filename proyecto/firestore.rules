rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isProfessor() {
      return request.auth != null && exists(/databases/$(database)/documents/system/professors/$(request.auth.token.email));
    }

    match /inviteLinks/{id} {
      allow read: if false;
      allow create, update: if isProfessor();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isProfessor());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isProfessor());
    }
  }
}
